+  // Seixo: raw bytes from the screenshot editor, written out so the rest of
+  // the path (size, copy into the App Group) treats them like any photo. The
+  // extension is guessed from the bytes; the app re-encodes it anyway.
+  private func saveScreenshotData(_ data: Data) -> URL? {
+    let isJpeg = data.starts(with: [0xFF, 0xD8, 0xFF])
+    let isHeic = data.count > 12 && String(data: data.subdata(in: 4..<8), encoding: .ascii) == "ftyp"
+    let ext = isJpeg ? "jpg" : (isHeic ? "heic" : "png")
+    guard let path = documentDirectoryPath()?.appendingPathComponent("screenshot.\(ext)") else {
+      return nil
+    }
+    do {
+      try data.write(to: path)
+      return path
+    } catch {
+      return nil
+    }
+  }
