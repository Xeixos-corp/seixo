# Copy to supabase/.env before running `docker compose up` (self-host path only).
# Never commit the real .env — generate fresh secrets, do not reuse these placeholders.

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-32-chars-minimum-random-secret
ANON_KEY=change-me-generate-with-jwt-signed-by-JWT_SECRET
SERVICE_ROLE_KEY=change-me-generate-with-jwt-signed-by-JWT_SECRET
REALTIME_DB_ENC_KEY=change-me-16-chars
REALTIME_SECRET_KEY_BASE=change-me-64-chars-minimum-random-secret
SITE_URL=http://localhost:3000
